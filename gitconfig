[user]
	name = Martin Morissette
	email = martin.morissette@shopify.com
[core]
	excludesfile = ~/.gitignore_global
	editor = vim
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path =
[mergetool "sourcetree"]
	cmd = /Applications/SourceTree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[commit]
	template = ~/.stCommitMsg
[alias]
  pending = "!git log origin/$(git branch | grep "\\*" | cut -d ' ' -f2)..HEAD"
	ll = "!~/src/github.com/shopify-playground/mmorissette-tools/bin/git-ll"
[fetch]
	prune = true
[maintenance]
	repo = /Users/martinmorissette/world/git
[include]
	path = /Users/martinmorissette/.config/dev/gitconfig
[shop-world "stale-pr-cutoff"]
	main = 1780336348
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
